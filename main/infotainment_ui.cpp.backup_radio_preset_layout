  render_content();
  refresh_media();
}

void music_action(lv_event_t *e){
 int action=(int)(intptr_t)lv_event_get_user_data(e);

 if(action==0){
  music=LIBRARY;
 }
 else if(action==1){
  music_playing=!music_playing;
 }
 else if(action==2){
  selected_song=(selected_song+9)%10;
  music_elapsed=0;
 }
 else if(action==3){
  selected_song=(selected_song+1)%10;
  music_elapsed=0;
 }

   render_content();
  refresh_media();
}

