void page_click(lv_event_t *e){
 radio_hold_direction=0;
 radio_hold_ms=0;

 Page next=(Page)(intptr_t)lv_event_get_user_data(e);
 if(next==PHONE && phone!=CALLING && phone!=CONNECTED){
  phone=CONTACTS;
 }

 // Switching to Radio pauses music.
 if(next==RADIO){
  media_mode=0;music_playing=false;
 }else if(next==MUSIC){
  media_mode=1;
 }

 page=next;

 if(page==NAV){
  nav=NAV_HOME;
 }

 render_content();
   refresh_shell();
  refresh_media();
}
