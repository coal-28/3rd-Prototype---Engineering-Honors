// Scale direct page elements using the original 640x360 design coordinates.
// Avoid resizing the children of scrollable lists, which have their own coordinates.
void fit_hub_content(){
 if(page==TEMPERATURE)return;
 const int design_w=640,design_h=360;
 const int available_w=HUB_W-16,available_h=HUB_H-HUB_NAV_H-12;
 lv_obj_update_layout(content);
 int count=(int)lv_obj_get_child_count(content);
 for(int i=0;i<count;i++){
  lv_obj_t *obj=lv_obj_get_child(content,i);
  int x=lv_obj_get_x(obj),y=lv_obj_get_y(obj);
  int w=lv_obj_get_width(obj),h=lv_obj_get_height(obj);
  lv_obj_set_pos(obj,8+x*available_w/design_w,6+y*available_h/design_h);
  lv_obj_set_size(obj,w*available_w/design_w,h*available_h/design_h);
  if((page==PHONE && phone==CONTACTS) || (page==MUSIC && music==LIBRARY) ||
     (page==RADIO && !radio_dial_open)){
   if(lv_obj_has_flag(obj,LV_OBJ_FLAG_SCROLLABLE)){
    int list_w=lv_obj_get_width(obj);
    int n=(int)lv_obj_get_child_count(obj);
    for(int j=0;j<n;j++){
     lv_obj_t *child=lv_obj_get_child(obj,j);
     lv_obj_set_x(child,1);
     lv_obj_set_width(child,list_w-2);
    }
   }
  }
 }
}

